# Explicit local-only provider simulation. Never auto-falls back to fixtures.
FIXTURE_MODE=true
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://flatpal:local-demo-only@localhost:54329/flatpal?schema=public&connection_limit=5&connect_timeout=5
REDIS_HOST=localhost
REDIS_PORT=63799
# Demo-only signing key, not a production credential.
FIXTURE_SECRET=flatpal-fictional-local-demo-key
# Live mode: set FIXTURE_MODE=false and supply server-only credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
EXPO_ACCESS_TOKEN=
# Integration tests require a separate disposable database (never your normal DB).
TEST_DATABASE_URL=
TEST_REDIS_PORT=63800
